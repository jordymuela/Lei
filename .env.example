# Claude credentials. Leave unset if you've run `ant auth login`; the SDK finds that profile on its own.
ANTHROPIC_API_KEY=

# Optional overrides
# LEI_MODEL=claude-opus-5-5
# LEI_EFFORT=low
# PORT=3000
# HOST=127.0.0.1
# LEI_DATA_FILE=data/state.json

# Optional: natural voice through ElevenLabs. Without these, the browser's built-in voices are used.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
