# Claude credentials. Leave unset if you've run `ant auth login`; the SDK finds that profile on its own.
ANTHROPIC_API_KEY=

# Mode: "companion" (the Her-style friend, default) or "practice" (an English speaking partner).
# LEI_MODE=practice
# LEI_NATIVE_LANG=es-MX   # the learner's language: interface and explanations (es-MX, pt-BR, ...)
# LEI_TARGET_LANG=en-US   # the language being practised: speech recognition and voice

# Companion mode abilities (on by default): looking around this computer, reminders, web search, and
# writing files, running commands and opening apps, each only after you approve it.
# LEI_COMPUTER=off
# LEI_WEB=off
# LEI_WORKSPACE=~/Documents   # the folder Lei may look through and work in; defaults to your home folder

# Optional overrides
# LEI_MODEL=claude-opus-5-5   # Haiku 5.5 costs about 40x less per turn; check quality with an eval before switching
# LEI_EFFORT=low
# PORT=3000
# HOST=127.0.0.1
# LEI_DATA_FILE=data/state.json

# Voice. Run `npm run get-voice` once for Kokoro, an open-source voice that runs on this computer.
# Without it (or the options below) the browser's built-in voices are used.
# LEI_VOICE=auto              # kokoro | elevenlabs | openai | browser
# LEI_VOICE_DIR=data/voices

# Optional: a local speech server with OpenAI's /v1/audio/speech (Kokoro-FastAPI, Chatterbox, Orpheus, LocalAI...)
# LEI_TTS_URL=http://127.0.0.1:8880/v1
# LEI_TTS_VOICE=af_heart       # comma-separated voice names
# LEI_TTS_MODEL=tts-1

# Optional: natural voice through ElevenLabs.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
